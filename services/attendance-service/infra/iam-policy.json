{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/gym-attendance-service:*",
        "arn:aws:logs:us-east-1:000000000000:log-group:/gym/attendance-service:*"
      ]
    },
    {
      "Sid": "AuditAppendOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-audit"
      ]
    },
    {
      "Sid": "PublishOwnMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "GymBooking"
        }
      }
    },
    {
      "Sid": "PublishEvents",
      "Effect": "Allow",
      "Action": [
        "events:PutEvents"
      ],
      "Resource": [
        "arn:aws:events:us-east-1:000000000000:event-bus/gym-events"
      ]
    },
    {
      "Sid": "ReadOwnPolicy",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:000000000000:parameter/gym/attendance-service/policy"
      ]
    },
    {
      "Sid": "ConsumeAttendanceEventsQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:000000000000:gym-attendance-events"
      ]
    },
    {
      "Sid": "TablesAttendanceAttendanceSessionsMemberStandingStrikes",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-attendance",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-attendance/index/*",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-attendance-sessions",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-attendance-sessions/index/*",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-strikes",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-strikes/index/*",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-member-standing",
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-member-standing/index/*"
      ]
    },
    {
      "Sid": "AuditReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/gym-audit"
      ]
    },
    {
      "Sid": "WriteReports",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::gym-reports/reports/*"
      ]
    },
    {
      "Sid": "EncryptReports",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:000000000000:key/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": "alias/gym-reports"
        }
      }
    },
    {
      "Sid": "ReadInternalKeys",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:gym/attendance-service/internal-key*",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:gym/class-service/internal-key*",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:gym/booking-service/internal-key*"
      ]
    },
    {
      "Sid": "CallOtherServices",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:000000000000:function:gym-class-service",
        "arn:aws:lambda:us-east-1:000000000000:function:gym-booking-service"
      ]
    }
  ]
}
